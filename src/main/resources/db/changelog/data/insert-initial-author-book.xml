<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.24.xsd">

    <changeSet id="001-insert-initial-books" author="system">
        <comment>Insert initial book data</comment>

        <insert tableName="book">
            <column name="id" value="1"/>
            <column name="title" value="The Great Gatsby"/>
            <column name="author_id" value="1"/>
            <column name="page_count" value="180"/>
        </insert>

        <insert tableName="book">
            <column name="id" value="2"/>
            <column name="title" value="To Kill a Mockingbird"/>
            <column name="author_id" value="2"/>
            <column name="page_count" value="281"/>
        </insert>

        <rollback>
            <delete tableName="books">
                <where>id IN (1, 2)</where>
            </delete>
        </rollback>
    </changeSet>

</databaseChangeLog>